#!/usr/bin/env php
<?php

declare(strict_types=1);

if (!isset($_composer_autoload_path)) {
    fwrite(STDERR, "This command must be run through Composer.\n");
    exit(1);
}

$projectRoot = getcwd();

$commands = [
    ['npm', 'install'],
    ['npm', 'install', '--save-dev', 'webpack@5.98.0'], // bug fix for default mix in concrete builder
    ['npm', 'install', '--save-dev', '@types/node', '@types/bootstrap'],
    ['npm', 'install', '--save', 'bootstrap', '@popperjs/core']
];

foreach ($commands as $command) {
    $process = proc_open(
        $command,
        [0 => STDIN, 1 => STDOUT, 2 => STDERR],
        $pipes,
        $projectRoot
    );

    if (!is_resource($process)) {
        throw new RuntimeException('Unable to start npm.');
    }

    $exitCode = proc_close($process);
    if ($exitCode !== 0) {
        exit($exitCode);
    }
}

$packageDirectory = dirname(__DIR__);
$stylesFolder = $packageDirectory . '/resources/styles';
$scriptsFolder = $packageDirectory . '/resources/scripts';

$projectRoot = dirname($_composer_autoload_path);
$stylesDestinationFolder = $projectRoot . '/../resources/css/';
$scriptsDestinationFolder = $projectRoot . '/../resources/js/';

if (!is_dir($stylesDestinationFolder . 'utils')) {
    mkdir($stylesDestinationFolder . 'utils');
}

if (!is_dir($scriptsDestinationFolder . 'utils')) {
    mkdir($scriptsDestinationFolder . 'utils');
}

foreach (new DirectoryIterator($stylesFolder) as $file) {
    if ($file->isFile()) {
        $sourceFile = $stylesFolder . '/' . $file->getFilename();
        $destinationFile = $stylesDestinationFolder . 'utils/' . $file->getFilename();

        if (!copy($sourceFile, $destinationFile)) {
            fwrite(STDERR, "Unable to copy: {$file->getFilename()}\n");
            exit(1);
        }
    }
}

foreach (new DirectoryIterator($scriptsFolder) as $file) {
    if ($file->isFile()) {
        $sourceFile = $scriptsFolder . '/' . $file->getFilename();
        $destinationFile = $scriptsDestinationFolder . 'utils/' . $file->getFilename();

        if (!copy($sourceFile, $destinationFile)) {
            fwrite(STDERR, "Unable to copy: {$file->getFilename()}\n");
            exit(1);
        }
    }
}

echo "Resources installation complete" . PHP_EOL;
