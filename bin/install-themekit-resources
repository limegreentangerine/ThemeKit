#!/usr/bin/env php
<?php

declare(strict_types=1);

if (!isset($_composer_autoload_path)) {
    fwrite(STDERR, "This command must be run through Composer.\n");
    exit(1);
}

$packageDirectory = dirname(__DIR__);
$resourcesFolder = $packageDirectory . '/resources';

$projectRoot = dirname($_composer_autoload_path);
$destination = $projectRoot . '/../public/';

foreach (new DirectoryIterator($resourcesFolder) as $file) {
    if ($file->isFile()) {
        echo $file->getPathname() . PHP_EOL;
    }
}

