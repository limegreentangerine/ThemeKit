#!/usr/bin/env php
<?php

declare(strict_types=1);

if (!isset($_composer_autoload_path)) {
    fwrite(STDERR, "This command must be run through Composer.\n");
    exit(1);
}

$projectRoot = getcwd();

// TODO: 'webpack@5.98.0' bug fix for default mix in concrete builder needs checking on a new install
$commands = [
    ['npm', 'install', '--save-dev', 'bootstrap', '@popperjs/core', '@types/node', '@types/bootstrap', 'webpack@5.98.0'],
];

foreach ($commands as $command) {
    $process = proc_open(
        $command,
        [0 => STDIN, 1 => STDOUT, 2 => STDERR],
        $pipes,
        $projectRoot
    );

    if (!is_resource($process)) {
        throw new RuntimeException('Unable to start npm.');
    }

    $exitCode = proc_close($process);
    if ($exitCode !== 0) {
        exit($exitCode);
    }
}

$packageDirectory = dirname(__DIR__);
$projectRoot = dirname($_composer_autoload_path);
$stylesFolder = $packageDirectory . '/resources/styles';
$stylesDestinationFolder = $projectRoot . '/../resources/css/';
$styleFolders = [
    'core',
    'blocks',
    'elements',
    'templates'
];

if (!is_dir($stylesDestinationFolder . 'utils')) {
    mkdir($stylesDestinationFolder . 'utils');
}

foreach ($styleFolders as $folder) {
    if (!is_dir($stylesDestinationFolder . $folder)) {
        mkdir($stylesDestinationFolder . $folder);
    }
}

foreach (new DirectoryIterator($stylesFolder) as $file) {
    if ($file->isFile()) {
        $sourceFile = $stylesFolder . '/' . $file->getFilename();
        $destinationFile = $stylesDestinationFolder . 'utils/' . $file->getFilename();

        if (!copy($sourceFile, $destinationFile)) {
            fwrite(STDERR, "Unable to copy: {$file->getFilename()}\n");
            exit(1);
        }
    }
}

$scriptsFolder = $packageDirectory . '/resources/scripts';
$scriptsDestinationFolder = $projectRoot . '/../resources/js/';
$scriptsFolders = [
    'core',
    'blocks',
    'elements',
    'templates'
];

if (!is_dir($scriptsDestinationFolder . 'utils')) {
    mkdir($scriptsDestinationFolder . 'utils');
}

foreach ($scriptsFolders as $folder) {
    if (!is_dir($scriptsDestinationFolder . $folder)) {
        mkdir($scriptsDestinationFolder . $folder);
    }
}

foreach (new DirectoryIterator($scriptsFolder) as $file) {
    if ($file->isFile()) {
        $sourceFile = $scriptsFolder . '/' . $file->getFilename();
        $destinationFile = $scriptsDestinationFolder . 'utils/' . $file->getFilename();

        if (!copy($sourceFile, $destinationFile)) {
            fwrite(STDERR, "Unable to copy: {$file->getFilename()}\n");
            exit(1);
        }
    }
}

$skeletonFolder = $packageDirectory . '/resources/skeleton';
$skeletonDestinationFolder = $projectRoot . '/../public/application/themes';

do {
    echo 'Theme folder name (inside ' . $skeletonDestinationFolder . '): ';
    $themeFolderName = trim((string) fgets(STDIN));
    $isValidName = preg_match('/^[A-Za-z0-9_-]+$/', $themeFolderName) === 1;
    if (!$isValidName) {
        echo "Use only letters, numbers, hyphens and underscores." . PHP_EOL;
    }
} while (!$isValidName);

$skeletonDestinationFolder .= '/' . $themeFolderName;
if (!is_dir($skeletonDestinationFolder) && !mkdir($skeletonDestinationFolder, 0755, true)) {
    fwrite(STDERR, "Unable to create: {$skeletonDestinationFolder}\n");
    exit(1);
}

$skeletonIterator = new RecursiveIteratorIterator(
    new RecursiveDirectoryIterator($skeletonFolder, FilesystemIterator::SKIP_DOTS),
    RecursiveIteratorIterator::SELF_FIRST
);

foreach ($skeletonIterator as $item) {
    $relativePath = $skeletonIterator->getSubPathname();
    $destination = $skeletonDestinationFolder . '/' . $relativePath;

    if ($item->isDir()) {
        if (!is_dir($destination) && !mkdir($destination, 0755, true)) {
            fwrite(STDERR, "Unable to create: {$relativePath}\n");
            exit(1);
        }
    } elseif (file_exists($item->getPathname())) {
        echo "{$relativePath} exists -- (ignored)\n";
        continue;
    } elseif (!copy($item->getPathname(), $destination)) {
        fwrite(STDERR, "Unable to copy: {$relativePath}\n");
        exit(1);
    }
}

echo "Resources installation complete" . PHP_EOL;
